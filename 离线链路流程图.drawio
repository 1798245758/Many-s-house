<mxfile host="Electron">
  <diagram name="离线链路（文件向量化入库）" id="0">
    <mxGraphModel dx="1998" dy="602" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1600" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="start" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" value="上传触发&#xa;POST /api/documents/upload&#xa;submit_task：先落盘 queued checkpoint" vertex="1">
          <mxGeometry height="90" width="220" x="360" y="30" as="geometry" />
        </mxCell>
        <mxCell id="worker" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" value="工人线程池（max_workers=2）&#xa;invoke(None) 从 checkpoint 断点续跑&#xa;thread_id = task_id" vertex="1">
          <mxGeometry height="90" width="220" x="360" y="190" as="geometry" />
        </mxCell>
        <mxCell id="e_start_worker" edge="1" parent="1" source="start" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="worker" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="extract" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="extract 解析文档（进度 0~30%）&#xa;Loaders 解析 docx/pdf/pptx/md/&#xa;txt/excel/xmind；图片用占位文本&#xa;并写入 metadata / structure" vertex="1">
          <mxGeometry height="110" width="220" x="360" y="350" as="geometry" />
        </mxCell>
        <mxCell id="e_worker_extract" edge="1" parent="1" source="worker" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;fontSize=11;" target="extract" value="START →">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="clean" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="clean 清洗文本（30~40%）&#xa;标准化文本清洗流程" vertex="1">
          <mxGeometry height="80" width="220" x="360" y="530" as="geometry" />
        </mxCell>
        <mxCell id="e_extract_clean" edge="1" parent="1" source="extract" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;fontSize=11;" target="clean" value="通过 → 下一阶段">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="chunk" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="chunk 语义切块（40~50%）&#xa;semantic_chunk → chunks 列表" vertex="1">
          <mxGeometry height="80" width="220" x="360" y="680" as="geometry" />
        </mxCell>
        <mxCell id="e_clean_chunk" edge="1" parent="1" source="clean" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="chunk" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="embed" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="embed 向量化（50~90%）&#xa;vectorize_chunks（BGE 768 维）" vertex="1">
          <mxGeometry height="90" width="220" x="360" y="830" as="geometry" />
        </mxCell>
        <mxCell id="e_chunk_embed" edge="1" parent="1" source="chunk" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="embed" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="wait_retry" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" value="wait_retry&#xa;blocked 退避等待 2 秒&#xa;重试计数 +1" vertex="1">
          <mxGeometry height="90" width="200" x="40" y="830" as="geometry" />
        </mxCell>
        <mxCell id="e_embed_wait" edge="1" parent="1" source="embed" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.3;exitDx=0;exitDy=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;fontSize=11;" target="wait_retry" value="服务不可用且重试未满 3 次">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_wait_embed" edge="1" parent="1" source="wait_retry" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;fontSize=11;" target="embed" value="退避结束重试">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="index" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="index 写入索引（90~100%）&#xa;SQLite chunks 表（含向量字节）&#xa;+ ChromaDB 向量库" vertex="1">
          <mxGeometry height="100" width="220" x="360" y="1080" as="geometry" />
        </mxCell>
        <mxCell id="e_embed_index" edge="1" parent="1" source="embed" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;fontSize=11;" target="index" value="向量化成功">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="finalize" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" value="finalize 收口&#xa;释放取消标志；失败/取消时&#xa;清理已写 chunks 与向量，&#xa;终态同步到文档表" vertex="1">
          <mxGeometry height="110" width="220" x="360" y="1250" as="geometry" />
        </mxCell>
        <mxCell id="e_index_finalize" edge="1" parent="1" source="index" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;fontSize=11;" target="finalize" value="SUCCEEDED 终态">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="end" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="END&#xa;succeeded / failed / cancelled&#xa;均落盘 checkpoint" vertex="1">
          <mxGeometry height="90" width="220" x="360" y="1430" as="geometry" />
        </mxCell>
        <mxCell id="e_finalize_end" edge="1" parent="1" source="finalize" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="end" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_fail_finalize" edge="1" parent="1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;strokeColor=#b85450;labelBackgroundColor=#ffffff;fontSize=11;" value="各阶段通用：&#xa;命中取消 / 阶段异常（含重试耗尽）&#xa;→ finalize 收口">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="-100" y="410" />
              <mxPoint x="-100" y="1310" />
            </Array>
            <mxPoint x="240" y="409.9999999999999" as="sourcePoint" />
            <mxPoint x="240" y="1310.0000000000002" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ckpt_note" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;dashed=1;align=left;spacingLeft=10;" value="Checkpoint（SqliteSaver）&#xa;每阶段结束 = 一次 super-step，&#xa;状态机取值/阶段/进度自动落盘；&#xa;SSE 推流与刷新重连读 checkpoint，&#xa;get_state_history 即状态流转事件日志" vertex="1">
          <mxGeometry height="130" width="300" x="700" y="350" as="geometry" />
        </mxCell>
        <mxCell id="route_note" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;align=left;spacingLeft=10;" value="每阶段出口条件边 _after_stage&#xa;· 命中取消 → finalize（cancelled）&#xa;· 阶段异常 → finalize（failed）&#xa;· blocked → wait_retry&#xa;· 其余 → 下一阶段&#xa;阶段开始时 _announce 提前写&#xa;“XX 中…” checkpoint 供前端展示" vertex="1">
          <mxGeometry height="180" width="300" x="700" y="560" as="geometry" />
        </mxCell>
        <mxCell id="machine_note" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;align=left;spacingLeft=10;" value="状态机（machine.py 唯一事实源）&#xa;queued → running → blocked ⇄ running&#xa;→ succeeded / failed / cancelled&#xa;非法转移抛 IllegalTaskTransition；&#xa;重启兜底：残留 processing 文档回置 error" vertex="1">
